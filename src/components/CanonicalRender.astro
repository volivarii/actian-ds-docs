---
// CanonicalRender — the component, drawn, on its own Code tab.
//
// actian-ds-knowledge derives a canonical HTML render for every component it
// can draw and ships it in the vendor snapshot as
// vendor/components/render/dist/fragments/<slug>.html, alongside the
// stylesheet that paints it. 56 of those fragments have been sitting in this
// repo's own tree, referenced by nothing, while all 73 Code tabs said
// "Per-component token documentation pending" and nothing else.
//
// The markup is read at build time, so a slug with no fragment renders
// nothing at all rather than an empty frame or a promise.
//
// Fonts: render-fonts.css (345KB of base64 woff2) is deliberately NOT shipped.
// --zen-font-family-text is "Roboto", sans-serif, so the example falls back to
// the reader's sans face. Honest, not pixel-perfect.
import fs from "node:fs";
import path from "node:path";

interface Props {
  slug: string;
  name?: string;
}

const { slug, name } = Astro.props;

const fragmentFile = path.resolve(
  process.cwd(),
  "vendor/components/render/dist/fragments",
  `${slug}.html`,
);

let markup: string | null = null;
try {
  markup = fs.readFileSync(fragmentFile, "utf8").trim() || null;
} catch {
  markup = null;
}

// render.css is class-scoped throughout (zero bare-element rules, checked), so
// loading it on the page cannot restyle the docs chrome around it.
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, "");
---

{
  markup && (
    <div class="canonical-render not-content">
      <link rel="stylesheet" href={`${BASE}/render/render.css`} />
      <div class="canonical-render__stage" set:html={markup} />
      <details class="canonical-render__source">
        <summary>Markup</summary>
        <pre><code>{markup}</code></pre>
      </details>
      <p class="canonical-render__note">
        Derived from the Figma capture by actian-ds-knowledge and vendored with
        this site. {name || slug} renders here from the same markup and
        stylesheet the plugin uses.
      </p>
    </div>
  )
}

<style>
  .canonical-render {
    margin: 1.5rem 0;
  }
  .canonical-render__stage {
    padding: 24px;
    border: 1px solid var(--docs-border-default, #d8d8de);
    border-radius: 4px;
    background: var(--docs-color-bg-default, #fff);
    overflow-x: auto;
  }
  .canonical-render__source {
    margin-top: 8px;
  }
  .canonical-render__source summary {
    cursor: pointer;
    font-size: 0.8125rem;
    color: var(--docs-color-text-secondary, #55555f);
  }
  .canonical-render__source pre {
    max-height: 24rem;
    overflow: auto;
    font-size: 0.75rem;
  }
  .canonical-render__note {
    margin-top: 8px;
    font-size: 0.75rem;
    color: var(--docs-color-text-secondary, #55555f);
  }
</style>
